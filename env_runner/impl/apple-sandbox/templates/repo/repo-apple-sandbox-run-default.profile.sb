;; Базовий whitelist-first sandbox-профіль для одного репозиторію.
;; {{REPO_PATH}} підставляється repos.sh реальним абсолютним шляхом до репо
;; в момент копіювання цього темплейту в runners/.

(version 1)

;; забороняє все, що не дозволено явно нижче — фундамент whitelist-first підходу
(deny default)

;; список бінарників, які дозволено запускати всередині цього репо;
;; додавай сюди нові за потреби (напр. node, npm, git), інакше вони впадуть
;; з "Operation not permitted"
(allow process-exec
  (literal "/bin/bash")
  (literal "/bin/zsh")
  (literal "/usr/bin/env"))

;; мінімальний набір системних шляхів для читання, без якого не запускаються
;; навіть базові бінарники з переліку вище
(allow file-read*
  (subpath "/usr/lib")
  (subpath "/System/Library")
  (subpath "/private/var/db/dyld"))

;; повний доступ на читання й запис — тільки в межах цього конкретного репозиторію
(allow file-read* file-write*
  (subpath "{{REPO_PATH}}"))

;; дозволяє мережу для цього репо; закоментуй рядок нижче, якщо цей репо
;; не повинен мати доступу до інтернету
(allow network*)
