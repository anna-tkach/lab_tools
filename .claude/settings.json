{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Explanatory",
  "model": "sonnet",
  "effortLevel": "medium",
  "modelOverrides": {
    "Explore": "haiku",
    "Plan": "opus"
  },
  "alwaysThinkingEnabled": false,
  "autoUpdatesChannel": "stable",
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "permissions": {
    "defaultMode": "manual",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(git reset:*)",
    ],
    "ask": [
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)"
    ]
  }
}

